# Images and local ports
POSTGRES_IMAGE=postgres:16-alpine
N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest
EVOLUTION_IMAGE=atendai/evolution-api:latest
POSTGRES_PORT=5432
N8N_PORT=5678
MOCK_API_PORT=8090
EVOLUTION_PORT=8088

# Database
POSTGRES_DB=gold_star
POSTGRES_USER=gold_star
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_INTERNAL_PORT=5432

# n8n
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_KEY=
N8N_WEBHOOK_URL=http://localhost:5678
INTERNAL_N8N_WEBHOOK_URL=http://n8n:5678
N8N_POSTGRES_CREDENTIAL_ID=
N8N_POSTGRES_CREDENTIAL_NAME=Gold Star Postgres

# Application mode: mock or live
AI_MODE=mock
BACKEND_MODE=mock
BACKEND_BASE_URL=http://mock-api:8090
PUBLIC_BACKEND_URL=http://localhost:8090
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano

# WhatsApp / Evolution API
EVOLUTION_API_URL=http://mock-api:8090
EVOLUTION_API_KEY=change-me
EVOLUTION_INSTANCE=goldstar

# Payment webhook security
ASAAS_WEBHOOK_TOKEN=change-me

# Optional monitoring. Empty disables outbound alert delivery.
SLACK_WEBHOOK_URL=
ALERT_WEBHOOK_URL=http://mock-api:8090/alerts
