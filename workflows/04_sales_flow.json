    {
      "parameters": {
        "jsCode": "const payload = $json.state_payload ?? {};\nif (!payload.passenger_name && $json.full_name && $json.full_name !== 'Cliente') payload.passenger_name = $json.full_name;\nif (!payload.passenger_cpf && $json.cpf) payload.passenger_cpf = $json.cpf;\nconst labels = { origin: 'origem', destination: 'destino', travel_date: 'data da viagem', passenger_name: 'nome do passageiro', passenger_cpf: 'CPF do passageiro' };\nconst missing = Object.keys(labels).filter((key) => !payload[key]);\nreturn [{ json: { session_id: $json.id, phone_number: $json.phone_number, payload, complete: missing.length === 0, missing, prompt: missing.length ? 'Para continuar, informe: ' + missing.map((k) => labels[k]).join(', ') + '.' : '' } }];"
      },
      "id": "gold-star-0032",
      "name": "Evaluate Required Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "gold-star-0033",
              "leftValue": "={{ $json.complete }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "gold-star-0034",
      "name": "Data Complete?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE conversational_sessions\nSET current_state = CASE\n    WHEN NOT ($2::jsonb ? 'origin') OR NOT ($2::jsonb ? 'destination') OR NOT ($2::jsonb ? 'travel_date')\n      THEN 'COLLECTING_TRIP'::conversation_state\n    WHEN NOT ($2::jsonb ? 'passenger_name') OR NOT ($2::jsonb ? 'passenger_cpf')\n      THEN 'COLLECTING_PASSENGER'::conversation_state\n    ELSE current_state\n  END,\n  state_payload = $2::jsonb\nWHERE id=$1\nRETURNING *;",
        "options": {
          "queryReplacement": "={{ [$json.session_id, JSON.stringify($json.payload)] }}"
        }
      },
      "id": "gold-star-0035",
      "name": "Persist Collection State",
