      "id": "gold-star-0037",
      "name": "Check Availability",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        170
      ]
    },
    {
      "parameters": {
        "jsCode": "const request = $('Evaluate Required Data').item.json;\nconst trip = $json.trip ?? $json.trips?.[0] ?? $json;\nconst seats = trip.available_seat_numbers ?? trip.seats?.filter((s) => s.status === 'AVAILABLE').map((s) => s.seat_number ?? s.number) ?? [];\nconst seat = request.payload.seat_number ?? seats[0] ?? trip.available_seat;\nconst available = Boolean(trip.id && seat && (trip.available_seats ?? seats.length ?? 0) > 0);\nreturn [{ json: { ...request, available, trip_id: trip.id, route_id: trip.route_id, available_seat: seat, price_cents: trip.price_cents ?? Math.round(Number(trip.price ?? 0) * 100) } }];"
      },
