      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/api/v1/workflows/execute-queries",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "session_id",
              "value": "={{ $('Execute Trigger').item.json.session_id }}"
            }
          ]
        }
      },
      "id": "e11c45fg-66de-4dfb-bbcc-77aa88dd0027",
      "name": "Trigger Query Flow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1250,
        300
      ]
    }
  ],
