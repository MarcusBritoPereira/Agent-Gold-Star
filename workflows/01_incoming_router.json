          "id": "stfIva6E9dYUW12u",
          "name": "Gold Star Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM conversational_sessions WHERE user_id = '{{ $json.id }}' AND expires_at > NOW() ORDER BY created_at DESC LIMIT 1;",
        "additionalFields": {
          "alwaysOutputData": true
        }
      },
