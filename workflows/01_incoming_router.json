{
  "name": "01 - WhatsApp Incoming Router",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-webhook",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "gold-star-0001",
      "name": "WhatsApp Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const root = $json.body ?? $json;\nconst data = root.data ?? {};\nconst key = data.key ?? {};\n// Na Evolution, root.sender costuma ser o número da instância.\n// O cliente real vem em data.key.remoteJid quando fromMe=false.\nconst sender = key.remoteJid ?? root.sender ?? '';\nconst phone = String(sender).split('@')[0].replace(/\\D/g, '');\nconst eventId = String(key.id ?? root.event_id ?? '');\nconst messageType = data.messageType ?? 'conversation';\nconst message = data.message?.conversation ?? data.message?.extendedTextMessage?.text ?? data.text ?? '';\nif (!phone || !eventId || key.fromMe === true) return [];\nreturn [{ json: { event_id: eventId, phone_number: phone, full_name: String(data.pushName ?? 'Cliente').slice(0, 200), message: String(message).trim().slice(0, 4000), message_type: messageType, raw_payload: root } }];"
      },
      "id": "gold-star-0002",
      "name": "Normalize and Validate Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH inserted AS (\n  INSERT INTO inbound_events(event_id, phone_number, payload)\n  VALUES ($1, $2, $3::jsonb)\n  ON CONFLICT (event_id) DO NOTHING\n  RETURNING event_id\n)\nSELECT EXISTS(SELECT 1 FROM inserted) AS is_new;",
        "options": {
          "queryReplacement": "={{ [$('Normalize and Validate Event').item.json.event_id, $('Normalize and Validate Event').item.json.phone_number, JSON.stringify($('Normalize and Validate Event').item.json.raw_payload)] }}"
        }
      },
      "id": "gold-star-0003",
      "name": "Register Inbound Event",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1240,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "__POSTGRES_CREDENTIAL_ID__",
          "name": "__POSTGRES_CREDENTIAL_NAME__"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "gold-star-0004",
              "leftValue": "={{ $json.is_new }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "gold-star-0005",
      "name": "Is New Event?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1450,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO users(phone_number, full_name)\nVALUES ($1, NULLIF($2, ''))\nON CONFLICT (phone_number) DO UPDATE SET full_name = COALESCE(NULLIF(EXCLUDED.full_name, ''), users.full_name)\nRETURNING *;",
        "options": {
          "queryReplacement": "={{ [$('Normalize and Validate Event').item.json.phone_number, $('Normalize and Validate Event').item.json.full_name] }}"
        }
      },
      "id": "gold-star-0006",
      "name": "Upsert User",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1660,
        220
      ],
      "credentials": {
        "postgres": {
          "id": "__POSTGRES_CREDENTIAL_ID__",
          "name": "__POSTGRES_CREDENTIAL_NAME__"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH active AS (\n  SELECT * FROM conversational_sessions WHERE user_id = $1 AND expires_at > now() AND current_state NOT IN ('COMPLETED','FAILED') ORDER BY created_at DESC LIMIT 1\n), created AS (\n  INSERT INTO conversational_sessions(user_id)\n  SELECT $1 WHERE NOT EXISTS (SELECT 1 FROM active)\n  RETURNING *\n)\nSELECT * FROM active UNION ALL SELECT * FROM created LIMIT 1;",
        "options": {
          "queryReplacement": "={{ [$json.id] }}"
        }
      },
      "id": "gold-star-0007",
      "name": "Get or Create Session",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1880,
        220
      ],
      "credentials": {
        "postgres": {
          "id": "__POSTGRES_CREDENTIAL_ID__",
          "name": "__POSTGRES_CREDENTIAL_NAME__"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.INTERNAL_N8N_WEBHOOK_URL + '/webhook/ai-agent' }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ session_id: $json.id, user_id: $json.user_id, phone_number: $('Normalize and Validate Event').item.json.phone_number, message: $('Normalize and Validate Event').item.json.message, message_type: $('Normalize and Validate Event').item.json.message_type, current_state: $json.current_state, state_payload: $json.state_payload }) }}"
      },
      "id": "gold-star-0008",
      "name": "Call Intent Workflow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2100,
        220
      ]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.message_type }}",
        "rules": {
          "rules": [
            {
              "operation": "regex",
              "value2": "^(audioMessage|extendedAudioMessage)$"
            }
          ]
        },
        "fallbackOutput": 1
      },
      "id": "gold-star-audio-switch",
      "name": "Is Audio?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL + '/chat/getBase64FromMediaMessage/' + $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"message\": {\n    \"key\": {{ JSON.stringify($('Normalize and Validate Event').item.json.raw_payload.data.key) }}\n  }\n}",
        "options": {}
      },
      "id": "gold-star-audio-http",
      "name": "Get Audio Base64",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const base64 = $json.base64;\nconst original = $('Normalize and Validate Event').item.json;\nif (!base64) return [{ json: original }];\nreturn [{\n  json: original,\n  binary: {\n    data: {\n      data: base64,\n      mimeType: 'audio/ogg',\n      fileName: 'audio.ogg'\n    }\n  }\n}];"
      },
      "id": "gold-star-audio-code",
      "name": "Prepare Audio Binary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        100
      ]
    },
    {
      "parameters": {
        "resource": "audio",
        "operation": "transcribe",
        "binaryPropertyName": "data",
        "options": {}
      },
      "id": "gold-star-audio-whisper",
      "name": "OpenAI Whisper",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        1060,
        100
      ],
      "credentials": {
        "openAiApi": {
          "id": "3GyFEUPzMb0NvMtk",
          "name": "Gold Star OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const original = $('Normalize and Validate Event').item.json;\noriginal.message = $json.text || '';\nreturn [{ json: original }];"
      },
      "id": "gold-star-audio-merge",
      "name": "Inject Transcription",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1260,
        100
      ]
    }
  ],
