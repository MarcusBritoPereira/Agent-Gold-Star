{
  "name": "02 - IA Conversational Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ai-agent",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "gold-star-agent-webhook",
      "name": "Agent Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "sessionId",
              "value": "={{ $json.body.session_id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "gold-star-set-session",
      "name": "Set Session ID",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        150,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Agent Webhook').item.json.body.message }}",
        "options": {
          "systemMessage": "Você é o assistente virtual de vendas da empresa de viagens hidroviárias Gold Star. Seu objetivo é ajudar o usuário a encontrar viagens e comprar passagens de forma conversacional e amigável.\n\nRegras:\n1. Colete a Cidade de Origem e a Cidade de Destino.\n2. Chame a ferramenta Buscar_Rotas informando a origem para encontrar as opções disponíveis e os seus IDs (route_id). Se a origem não retornar nada, informe o usuário.\n3. Apresente as opções de rotas ao usuário, informando os horários e preços. Pergunte em qual data ele deseja viajar (o formato da data para a API deve ser AAAA-MM-DD).\n4. Com o route_id e a data escolhida, chame a ferramenta Consultar_Assentos para verificar se há vagas (available_seats > 0). Essa ferramenta também retorna o trip_id.\n5. Se houver vagas, informe que está disponível e peça os dados do passageiro: CPF, Nome Completo e Data de Nascimento.\n6. Com os dados completos (route_id, trip_id, data, preço, nome, cpf e data de nascimento), chame a ferramenta Gerar_Pagamento.\n7. Entregue o Link de Pagamento (payment_link) gerado ao usuário de forma clara.\n8. Seja gentil, persuasivo e use emojis moderadamente. Responda apenas com o texto final que será enviado ao cliente no WhatsApp."
        }
      },
      "id": "gold-star-agent-node",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {}
      },
      "id": "gold-star-agent-gemini",
      "name": "Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        300,
        500
      ],
      "credentials": {
        "geminiApi": {
          "id": "__GEMINI_CREDENTIAL_ID__",
          "name": "__GEMINI_CREDENTIAL_NAME__"
        }
      }
    },
    {
      "parameters": {
        "contextWindowLength": 10,
        "tableName": "n8n_chat_histories",
        "sessionKey": "={{ $json.sessionId }}"
      },
      "id": "gold-star-agent-memory",
      "name": "Postgres Chat Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryPostgresChat",
      "typeVersion": 1.3,
      "position": [
        450,
        500
      ],
      "credentials": {
        "postgres": {
          "id": "__POSTGRES_CREDENTIAL_ID__",
          "name": "__POSTGRES_CREDENTIAL_NAME__"
        }
      }
    },
    {
      "parameters": {
        "name": "Buscar_Rotas",
        "description": "Busca rotas disponíveis a partir de uma cidade de origem. Retorna os route_id, destinos, horários e preços (speed_boat_price).",
        "placeholderDefinitions": {
          "values": [
            {
              "name": "origin",
              "description": "A cidade de origem",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "url": "https://embarcar-e83ea296df06.herokuapp.com/api/routes/show/",
        "sendQuery": true,
        "specifyQuery": "json",
        "jsonQuery": "{\n  \"q[origin_cont]\": \"{origin}\"\n}"
      },
      "id": "gold-star-agent-tool-buscar-rotas",
      "name": "Buscar_Rotas",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        600,
        500
      ]
    },
    {
      "parameters": {
        "name": "Consultar_Assentos",
        "description": "Verifica a disponibilidade de assentos para uma rota e data. Retorna o trip_id e a quantidade de vagas.",
        "placeholderDefinitions": {
          "values": [
            {
              "name": "route_id",
              "description": "O ID da rota (route_id) escolhida",
              "type": "number"
            },
            {
              "name": "date",
              "description": "Data da viagem no formato YYYY-MM-DD",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "url": "https://embarcar-e83ea296df06.herokuapp.com/api/routes/available_seats/",
        "sendQuery": true,
        "specifyQuery": "json",
        "jsonQuery": "{\n  \"web\": \"true\",\n  \"route_id\": {route_id},\n  \"date\": \"{date}\"\n}"
      },
      "id": "gold-star-agent-tool-consultar",
      "name": "Consultar_Assentos",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        720,
        500
      ]
    },
    {
      "parameters": {
        "name": "Gerar_Pagamento",
        "description": "Gera a ordem de pagamento. Requer route_id, trip_id, date, price, passenger_cpf, passenger_name, passenger_birthday.",
        "placeholderDefinitions": {
          "values": [
            {
              "name": "route_id",
              "description": "ID da Rota",
              "type": "number"
            },
            {
              "name": "trip_id",
              "description": "ID da Viagem",
              "type": "number"
            },
            {
              "name": "date",
              "description": "Data no formato YYYY-MM-DD",
              "type": "string"
            },
            {
              "name": "price",
              "description": "Preço da passagem (speed_boat_price)",
              "type": "number"
            },
            {
              "name": "passenger_cpf",
              "description": "CPF",
              "type": "string"
            },
            {
              "name": "passenger_name",
              "description": "Nome completo",
              "type": "string"
            },
            {
              "name": "passenger_birthday",
              "description": "Data de nascimento no formato YYYY-MM-DD",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "url": "https://embarcar-e83ea296df06.herokuapp.com/api/orders/create",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"route_id\": {route_id},\n  \"trip_id\": {trip_id},\n  \"date\": \"{date}\",\n  \"payment_method\": \"PIX\",\n  \"name\": \"{passenger_name}\",\n  \"phone\": \"{{ $('Agent Webhook').item.json.body.phone_number }}\",\n  \"customers\": { \"1\": \"{passenger_name}\" },\n  \"documents\": { \"1\": \"{passenger_cpf}\" },\n  \"document_types\": { \"1\": \"cpf\" },\n  \"birthdays\": [\"{passenger_birthday}\"],\n  \"data\": \"[{\\\"comodity\\\":\\\"Assento\\\",\\\"field\\\":\\\"speed_boat_price\\\",\\\"customer_fields\\\":1,\\\"min_customer_fields\\\":1,\\\"price\\\":{price},\\\"tax\\\":\\\"5.5\\\",\\\"quantity\\\":1}]\"\n}"
      },
      "id": "gold-star-agent-tool-pagamento",
      "name": "Gerar_Pagamento",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        840,
        500
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL + '/message/sendText/' + $env.EVOLUTION_INSTANCE }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ number: $('Agent Webhook').item.json.body.phone_number, text: $json.output }) }}"
      },
      "id": "gold-star-agent-send",
      "name": "Send Reply via WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        650,
        300
      ]
    }
  ],
