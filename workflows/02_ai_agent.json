        "body": "={{ JSON.stringify({ number: $('Agent Webhook').first().json.body.phone_number, text: \"Oops! 🙊 Ocorreu uma instabilidade no meu sistema e eu não consegui processar a sua mensagem. Poderia tentar novamente em alguns minutos? 🛥️💙\" }) }}"
      },
      "id": "gold-star-agent-send-fallback",
      "name": "Send Fallback Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        750,
        150
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ (String($env.EVOLUTION_API_URL).includes('localhost') || String($env.EVOLUTION_API_URL).includes('host.docker.internal')) ? 'http://evolution-api:8080' : $env.EVOLUTION_API_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ number: $('Agent Webhook').first().json.body.phone_number, text: $json.output }) }}"
      },
      "id": "gold-star-agent-send",
      "name": "Send Reply via WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
