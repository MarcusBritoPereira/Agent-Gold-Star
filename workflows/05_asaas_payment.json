{
  "name": "05 - Pagamento Asaas",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "create-payment",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "gold-star-0045",
      "name": "Payment Creation Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.*, u.phone_number, u.full_name, u.cpf FROM conversational_sessions s JOIN users u ON u.id=s.user_id WHERE s.id=$1;",
        "options": {
          "queryReplacement": "={{ [$json.body.session_id] }}"
        }
      },
      "id": "gold-star-0046",
      "name": "Get Checkout Context",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        230,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "__POSTGRES_CREDENTIAL_ID__",
          "name": "__POSTGRES_CREDENTIAL_NAME__"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const p=$json.state_payload; return [{json:{session_id:$json.id,phone_number:$json.phone_number,order:{trip_id:p.trip_id,seat_number:p.available_seat,travel_date:p.travel_date,origin:p.origin,destination:p.destination,price_cents:p.price_cents,customer:{name:p.passenger_name||$json.full_name,cpf:p.passenger_cpf||$json.cpf,phone:$json.phone_number},external_reference:$json.id}}}];"
      },
      "id": "gold-star-0047",
      "name": "Build Order Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_BASE_URL + '/api/orders/create' }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.order) }}"
      },
      "id": "gold-star-0048",
      "name": "Create Order",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        690,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const source=$json; const request=$('Build Order Payload').first().json; const orderId=source.id??source.order_id; const paymentLink=source.payment_link??source.payment_url; if(!orderId||!paymentLink) throw new Error('Backend não retornou order_id e payment_link'); return [{json:{...request,order_id:String(orderId),payment_link:String(paymentLink)}}];"
      },
      "id": "gold-star-0049",
      "name": "Validate Order Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE conversational_sessions SET current_state='EXPECTING_PAYMENT', state_payload=state_payload || $2::jsonb WHERE id=$1 RETURNING *;",
        "options": {
          "queryReplacement": "={{ [$json.session_id, JSON.stringify({ order_id: $json.order_id, payment_link: $json.payment_link })] }}"
        }
      },
      "id": "gold-star-0050",
      "name": "Save Order",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1140,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "__POSTGRES_CREDENTIAL_ID__",
          "name": "__POSTGRES_CREDENTIAL_NAME__"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL + '/message/sendText/' + $env.EVOLUTION_INSTANCE }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ number: $('Validate Order Response').first().json.phone_number, text: 'Pedido criado com sucesso. Para concluir a compra, pague pelo link: ' + $('Validate Order Response').first().json.payment_link }) }}"
      },
      "id": "gold-star-0051",
      "name": "Send Payment Link",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1370,
        300
      ]
    }
  ],
