            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Allocate Seat": {
      "main": [
        [
          {
            "node": "Complete Session",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Complete Session": {
      "main": [
        [
          {
            "node": "Send Voucher",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
