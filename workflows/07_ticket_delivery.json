{
  "name": "07 - Confirmação de Compra",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ticket-delivery",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "gold-star-0069",
      "name": "Ticket Delivery Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.*,u.phone_number,u.full_name FROM conversational_sessions s JOIN users u ON u.id=s.user_id WHERE s.id=$1 AND s.current_state='PAID';",
        "options": {
          "queryReplacement": "={{ [$json.body.session_id] }}"
        }
      },
      "id": "gold-star-0070",
      "name": "Get Paid Order Context",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        230,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "__POSTGRES_CREDENTIAL_ID__",
          "name": "__POSTGRES_CREDENTIAL_NAME__"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const p=$json.state_payload; const seat=p.seat_number??p.available_seat; if(!seat) throw new Error('Nenhuma poltrona disponível foi registrada'); return [{json:{session_id:$json.id,phone_number:$json.phone_number,full_name:p.passenger_name||$json.full_name||'Passageiro',order_id:p.order_id,allocation:{trip_id:p.trip_id,seat_numbers:[seat]},voucher_url:$env.PUBLIC_BACKEND_URL+'/orders/'+p.order_id}}];"
      },
      "id": "gold-star-0071",
      "name": "Build Seat Allocation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_BASE_URL + '/orders/seats/' + $json.order_id }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.allocation) }}"
      },
      "id": "gold-star-0072",
      "name": "Allocate Seat",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        690,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE conversational_sessions SET current_state='COMPLETED',state_payload=state_payload || $2::jsonb WHERE id=$1 AND current_state='PAID' RETURNING *;",
        "options": {
          "queryReplacement": "={{ [$('Build Seat Allocation').item.json.session_id, JSON.stringify({ voucher_url: $('Build Seat Allocation').item.json.voucher_url, delivered_at: new Date().toISOString() })] }}"
        }
      },
      "id": "gold-star-0073",
      "name": "Complete Session",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        920,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "__POSTGRES_CREDENTIAL_ID__",
          "name": "__POSTGRES_CREDENTIAL_NAME__"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL + '/message/sendText/' + $env.EVOLUTION_INSTANCE }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ number: $('Build Seat Allocation').item.json.phone_number, text: '🎉 Compra confirmada, ' + $('Build Seat Allocation').item.json.full_name + '! Seu bilhete está disponível em: ' + $('Build Seat Allocation').item.json.voucher_url }) }}"
      },
      "id": "gold-star-0074",
      "name": "Send Voucher",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1150,
        300
      ]
    }
  ],
  "connections": {
    "Ticket Delivery Webhook": {
      "main": [
        [
          {
            "node": "Get Paid Order Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Paid Order Context": {
      "main": [
        [
          {
