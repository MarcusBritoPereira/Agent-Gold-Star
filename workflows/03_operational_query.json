{
  "name": "03 - Consulta Operacional",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "operational-query",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "gold-star-0024",
      "name": "Query Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.state_payload, u.phone_number FROM conversational_sessions s JOIN users u ON u.id=s.user_id WHERE s.id=$1;",
        "options": {
          "queryReplacement": "={{ [$json.body.session_id] }}"
        }
      },
      "id": "gold-star-0025",
      "name": "Get Query Context",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        240,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "__POSTGRES_CREDENTIAL_ID__",
          "name": "__POSTGRES_CREDENTIAL_NAME__"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BACKEND_BASE_URL + '/api/routes/show/' }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "origin",
              "value": "={{ $json.state_payload.origin || '' }}"
            },
            {
              "name": "destination",
              "value": "={{ $json.state_payload.destination || '' }}"
            },
            {
              "name": "date",
              "value": "={{ $json.state_payload.travel_date || '' }}"
            }
          ]
        }
      },
      "id": "gold-star-0026",
      "name": "Query Routes API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        470,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const context = $('Get Query Context').item.json;\nconst intent = $('Query Webhook').item.json.body.intent;\nconst rows = Array.isArray($json) ? $json : ($json.routes ?? $json.trips ?? [$json]);\nif (!rows.length || !rows[0] || rows[0].available === false) return [{ json: { phone_number: context.phone_number, text: 'Não encontrei viagens com esses dados. Informe origem, destino e data para eu tentar novamente.' } }];\nconst lines = rows.slice(0, 5).map((r) => { const price = r.price ?? (r.price_cents != null ? 'R$ ' + (r.price_cents / 100).toFixed(2).replace('.', ',') : 'consulte'); return '• ' + (r.origin ?? context.state_payload.origin ?? '') + ' → ' + (r.destination ?? context.state_payload.destination ?? '') + ' | ' + (r.departure_time ?? r.time ?? 'horário a confirmar') + ' | ' + price; });\nconst title = intent === 'ASK_PRICES' ? 'Valores encontrados:' : 'Horários encontrados:';\nreturn [{ json: { phone_number: context.phone_number, text: title + '\\n' + lines.join('\\n') } }];"
      },
      "id": "gold-star-0027",
      "name": "Format Query Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL + '/message/sendText/' + $env.EVOLUTION_INSTANCE }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ number: $json.phone_number, text: $json.text }) }}"
      },
      "id": "gold-star-0028",
      "name": "Send Query Response",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        930,
        300
      ]
    }
  ],
  "connections": {
    "Query Webhook": {
      "main": [
        [
          {
